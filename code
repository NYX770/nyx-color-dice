<!DOCTYPE html>
<html lang="fr">
<head>

<meta charset="UTF-8">
<title>NYX COLOR DICE</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
min-height:100vh;
background:linear-gradient(135deg,#050816,#111827,#1e1b4b);
color:white;
text-align:center;
transition:1s;
}


h1{
margin-top:40px;
font-size:60px;
letter-spacing:6px;

text-shadow:
0 0 15px #8b5cf6,
0 0 35px #3b82f6,
0 0 60px #8b5cf6;
}



.card{

width:430px;
margin:30px auto;
padding:30px;

background:rgba(255,255,255,.08);
border-radius:25px;

backdrop-filter:blur(10px);

}



#idJoueur{

color:#a855f7;
font-weight:bold;

}



.verify{

display:flex;
justify-content:center;
gap:10px;
margin-top:15px;

}



input{

width:120px;
height:45px;

font-size:18px;
text-align:center;

border:none;
border-radius:10px;

}



button{

padding:12px 20px;

border:none;
border-radius:15px;

cursor:pointer;

color:white;

font-weight:bold;

background:linear-gradient(90deg,#8b5cf6,#3b82f6);

}



.options{

display:flex;
justify-content:center;
gap:15px;
margin-top:15px;

}



#diceContainer{

display:flex;
justify-content:center;
flex-wrap:wrap;

gap:20px;

margin:40px;

}



.dice{

width:90px;
height:90px;

border-radius:20px;

border:4px solid white;

display:inline-flex;

justify-content:center;
align-items:center;


box-shadow:

0 0 20px white,

inset -10px -10px 20px rgba(0,0,0,.4);

}



.dot{

width:25px;
height:25px;

background:white;

border-radius:50%;

}



.shake{

animation:shake .12s infinite;

}



@keyframes shake{

0%{
transform:translate(0);
}

25%{
transform:translate(4px,-3px);
}

50%{
transform:translate(-4px,3px);
}

75%{
transform:translate(3px,3px);
}

100%{
transform:translate(0);
}

}



.smallDice{

width:45px;
height:45px;

border-radius:12px;

border:3px solid white;

display:inline-flex;

justify-content:center;
align-items:center;

margin:5px;

}



.smallDice .dot{

width:13px;
height:13px;

}



.history{

width:80%;
max-width:600px;

margin:auto;

background:rgba(255,255,255,.08);

padding:20px;

border-radius:20px;

}



.entry{

padding:15px;

border-bottom:1px solid #ffffff33;

}



</style>

</head>



<body>


<h1>🎲 NYX COLOR DICE</h1>



<div class="card">


<p>
👤 Ton ID :
<br>
<span id="idJoueur"></span>
</p>



<div class="verify">

<input id="idVerification" placeholder="ID ami">

<button onclick="verifier()">

VERIFY

</button>

</div>



<br>


<p>Nombre de dés</p>


<div class="options">

<input id="nombre" type="number" min="1" max="50" value="5">


<button onclick="changerStyle()">

🎨 STYLE

</button>


</div>



<br>


<button onclick="lancer()">

🎲 LANCER LES DÉS

</button>


</div>



<h2>Résultat</h2>


<div id="diceContainer"></div>



<h2>📜 Historique</h2>


<div class="history" id="history"></div>



<script>


const couleurs=[

"#ff3b30",
"#2196F3",
"#22c55e",
"#FFD60A",
"#ff9500",
"#a855f7"

];



let id=localStorage.getItem("nyxID");


if(!id){

id="NYX-"+Math.random()
.toString(36)
.substring(2,8)
.toUpperCase();


localStorage.setItem("nyxID",id);

}


document.getElementById("idJoueur").innerHTML=id;




function creerDe(couleur,classe="dice"){


let de=document.createElement("div");

de.className=classe;

de.style.background=couleur;



let point=document.createElement("div");

point.className="dot";


de.appendChild(point);


return de;

}





function lancer(){


let nombre=
Number(document.getElementById("nombre").value);



if(nombre<1) nombre=1;

if(nombre>50) nombre=50;



let zone=document.getElementById("diceContainer");

zone.innerHTML="";

let des=[];



for(let i=0;i<nombre;i++){


let de=creerDe("white");


de.classList.add("shake");


de.querySelector(".dot").style.background="#555";


zone.appendChild(de);


des.push(de);


}



setTimeout(()=>{


let resultat=[];


des.forEach(de=>{


de.classList.remove("shake");


let couleur=
couleurs[
Math.floor(Math.random()*couleurs.length)
];


de.style.background=couleur;


de.querySelector(".dot").style.background="white";


resultat.push(couleur);


});


sauver(nombre,resultat);


},2000);


}




function sauver(nombre,resultat){


let historique=
JSON.parse(localStorage.getItem("historique")) || [];



historique.unshift({

id:id,

des:nombre,

resultat:resultat

});



historique=historique.slice(0,50);


localStorage.setItem(
"historique",
JSON.stringify(historique)
);


afficherHistorique(historique);


}





function afficherHistorique(data){


let box=document.getElementById("history");


box.innerHTML="";



data.forEach(h=>{


let html="";


h.resultat.forEach(c=>{


html+=`

<div class="smallDice" style="background:${c}">

<div class="dot"></div>

</div>

`;

});



box.innerHTML+=`

<div class="entry">

<b>${h.id}</b>

<br>

🎲 ${h.des} dés

<br>

${html}

</div>

`;

});


}




function verifier(){


let recherche=
document.getElementById("idVerification").value
.toUpperCase();


let historique=
JSON.parse(localStorage.getItem("historique")) || [];



let resultat=
historique.filter(
h=>h.id===recherche
);



if(resultat.length===0){

document.getElementById("history").innerHTML=
"<p>Aucun résultat trouvé</p>";

return;

}



afficherHistorique(resultat);


}





// Style du fond


let styleActuel=0;


const styles=[

"linear-gradient(135deg,#050816,#111827,#1e1b4b)",

"linear-gradient(135deg,#000000,#111111,#222222)",

"linear-gradient(135deg,#001a0d,#003d1a,#00aa55)",

"linear-gradient(135deg,#3a2600,#8a6200,#ffd700)"

];



function changerStyle(){


styleActuel++;


if(styleActuel>=styles.length){

styleActuel=0;

}


document.body.style.background=
styles[styleActuel];


}



afficherHistorique(
JSON.parse(localStorage.getItem("historique")) || []
);


</script>


</body>
</html>
